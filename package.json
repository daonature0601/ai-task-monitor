{
  "name": "ai-task-monitor",
  "version": "1.0.0",
  "description": "跨平台 AI 工具任务监控 — 实时追踪本机 Codex / Claude Code / CodeBuddy / WorkBuddy / Cursor / DeepSeek Harness / 元宝 的任务耗时与 Token 费用",
  "main": "./out/main/index.js",
  "author": "sanwuwy <sanwuwy@gmail.com>",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanwuwy/ai-task-monitor.git"
  },
  "homepage": "https://github.com/sanwuwy/ai-task-monitor#readme",
  "bugs": {
    "url": "https://github.com/sanwuwy/ai-task-monitor/issues"
  },
  "keywords": [
    "electron",
    "ai",
    "token-usage",
    "cost-tracking",
    "codex",
    "claude-code",
    "cursor",
    "menubar",
    "monitor"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup-native.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "icon": "node scripts/generate-icon.mjs",
    "dist:mac": "npm run icon && npm run build && electron-builder --mac",
    "dist:win": "npm run icon && npm run build && electron-builder --win",
    "smoke": "npm run build && ATM_SMOKE=1 electron out/main/index.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "chokidar": "^3.6.0",
    "classic-level": "^2.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.4.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.5.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "@electron/rebuild": "^3.7.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.5.0",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
